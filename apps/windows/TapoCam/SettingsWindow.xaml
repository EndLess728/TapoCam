<Window x:Class="TapoCam.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Settings" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="Camera Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <TextBlock Style="{StaticResource SectionTitle}" Text="CAMERA"/>
        <DockPanel>
            <Button x:Name="FindButton" DockPanel.Dock="Right" Content="Find" Width="84" Margin="8,0,0,0" Click="Find_Click"
                    ToolTip="Scan the local network for Tapo cameras"/>
            <Grid>
                <TextBox x:Name="HostBox" TextChanged="Field_Changed"/>
                <TextBlock x:Name="HostPlaceholder" Text="IP address, e.g. 192.168.0.108" Foreground="{StaticResource Secondary}"
                           Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </DockPanel>
        <ItemsControl x:Name="FoundList" Margin="0,6,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding}" Margin="0,0,6,6" Padding="10,4" Click="Found_Click"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource SectionTitle}" Text="CAMERA ACCOUNT (FOR VIDEO)" Margin="0,14,0,8"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="6"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Username" VerticalAlignment="Center"/>
            <TextBox x:Name="UserBox" Grid.Column="1" TextChanged="Field_Changed"/>
            <TextBlock Grid.Row="2" Text="Password" VerticalAlignment="Center"/>
            <PasswordBox x:Name="StreamPasswordBox" Grid.Row="2" Grid.Column="1" PasswordChanged="Field_Changed"/>
        </Grid>
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                   Text="Create this in the Tapo app: Camera → ⚙ → Advanced Settings → Camera Account."/>

        <TextBlock Style="{StaticResource SectionTitle}" Text="TAPO ACCOUNT (FOR PAN/TILT &amp; SETTINGS)" Margin="0,18,0,8"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Password" VerticalAlignment="Center"/>
            <PasswordBox x:Name="CloudPasswordBox" Grid.Column="1"/>
        </Grid>
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                   Text="The password you sign in to the Tapo app with. It's encrypted for your Windows account and only sent to the camera."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" Width="90" Margin="0,0,8,0"/>
            <Button x:Name="ConnectButton" Content="Connect" IsDefault="True" Width="90" Style="{StaticResource AccentButton}" Click="Connect_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
